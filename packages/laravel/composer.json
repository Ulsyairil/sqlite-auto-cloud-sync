{
    "name": "ulsyairil/sqlite-sync-laravel",
    "description": "Laravel adapter for sqlite-sync.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ulsyairil/sqlite-sync": "^0.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "SqliteSync\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SqliteSync\\Laravel\\SqliteSyncServiceProvider"
            ]
        }
    }
}
