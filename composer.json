{
    "name": "ulsyairil/sqlite-auto-cloud-sync",
    "description": "Row-level SQLite cloud sync core with Laravel, CodeIgniter and Symfony adapters.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "SqliteSync\\Core\\": "packages/core/src/",
            "SqliteSync\\S3\\": "packages/s3/src/",
            "SqliteSync\\Laravel\\": "packages/laravel/src/",
            "SqliteSync\\CodeIgniter\\": "packages/codeigniter/src/",
            "SqliteSync\\Symfony\\": "packages/symfony/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SqliteSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
